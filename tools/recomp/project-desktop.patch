diff --git a/CMakeLists.txt b/CMakeLists.txt
index 470f39c..ace6922 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -16,8 +16,7 @@ project(JumpingFlash2Recomp LANGUAGES C CXX)
 # The wizard (WIZARD_CMAKE_BLOCK / ENABLE_SETUP_WIZARD) is the first-run disc
