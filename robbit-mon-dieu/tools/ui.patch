+/* PAL title bridge: preserve the game's logo/background, add an ordinary sixth
+ * mouse/controller-selectable entry while original actions use guest dispatch. */
+void recomp_runtime_ui_render_title_entries(void *pixels,int width,int height,int pitch,int selection) {
+    if(!pixels || width!=640 || height!=480 || pitch<width*4) return;
+    static const char *entries[]={"GAME START","TIME ATTACK","LOAD","SAVE","OPTIONS","MODS"};
+    rect(pixels,width,height,pitch,90,282,460,156,0x171b57,255);
+    for(int row=0;row<6;++row) {
+        int y=294+row*24,tw=text_width(entries[row],2);
+        if(row==selection) rect(pixels,width,height,pitch,96,y,448,23,0x292c71,255);
+        draw_text(pixels,width,height,pitch,(640-tw)/2,y+5,2,row==selection?0xff922e:0xd5dbef,entries[row],544);
+        if(row==selection) draw_text(pixels,width,height,pitch,130,y+5,2,0xff922e,">",160);
+    }
+}
+#endif
